---
import { serviceGroups } from '../data/site';
interface Props { detailed?: boolean; intro?: string }
const { detailed = false, intro = 'One studio for the whole digital side of your business.' } = Astro.props;
// Line icons, shown only when a colour look is switched on (see styles/looks.css)
const icons: Record<string, string> = {
  Digital: '<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="6" width="26" height="20" rx="2"/><path d="M3 11h26M7 8.5h.01M10 8.5h.01M9 17l3 3-3 3M15 23h6"/></svg>',
  Creative: '<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="16" cy="16" r="11"/><circle cx="16" cy="16" r="4.5"/><path d="M16 5l3.5 6.5M27 16l-7 .5M21.5 26l-3.5-6M10.5 26.5l3-6.5M5 16l7-.5M10.5 5.5l3.5 6.5"/></svg>',
  Growth: '<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 26h24M7 22l6-6 5 4 9-10"/><path d="M21 10h6v6"/></svg>',
};
---
<div class:list={['services', { detailed }]}>
  <div class="intro" data-reveal>
    <p class="label">[ Services ]</p>
    <p class="lead">{intro}</p>
  </div>
  {serviceGroups.map((g) => (
    <div class="group" data-reveal>
      <span class="svc-ico" aria-hidden="true" set:html={icons[g.name] ?? ''} />
      <p class="label">{g.no}</p>
      <h3 class="caps">{g.name}</h3>
      {detailed && <p class="sum">{g.summary}</p>}
      <ul>{g.items.map((it) => <li>{it}</li>)}</ul>
    </div>
  ))}
</div>

<style>
  .services { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }
  .lead { font-size: 22px; line-height: 1.25; letter-spacing: -.01em; font-weight: 500; margin-top: 12px; max-width: 280px; }
  .caps { margin: 10px 0 16px; }
  .sum { font-size: 15px; color: #3C4547; margin: -4px 0 18px; max-width: 34ch; }
  li { font-size: 16px; line-height: 1.9; color: #3C4547; }
  @media (max-width: 1023px) { .services { grid-template-columns: 1fr 1fr; } .intro { grid-column: 1 / -1; } }
  @media (max-width: 479px) { .services.detailed { grid-template-columns: 1fr; } }
</style>
