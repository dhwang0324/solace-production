---
// "What we believe" on the Studio page: cards that stack on top of each other as you scroll.
interface Props { items: string[] }
const { items } = Astro.props;
const no = (i: number) => String(i + 1).padStart(2, '0');
---
<section class="pad section stack-wrap" aria-labelledby="believe-h">
  <div class="inner">
    <p class="label stack-label" id="believe-h" data-reveal="both">[ What we believe ]</p>
    <ol class="stack" data-stack>
      {items.map((b, i) => (
        <li class:list={['card', `card--${i + 1}`]} style={`--i:${i}`}>
          <div class="card__top"><span class="card__no">{no(i)}</span><span class="card__tag" aria-hidden="true">Belief</span></div>
          <p class="card__txt">{b}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .stack-wrap { padding-top: 0; }
  .stack-label { margin-bottom: 24px; }
  .stack { display: grid; gap: 28px; list-style: none; }
  .card {
    position: sticky; top: calc(110px + var(--i) * 16px);
    min-height: clamp(300px, 46vh, 460px); padding: 28px 32px 36px;
    display: flex; flex-direction: column; justify-content: space-between; gap: 40px;
    transform-origin: 50% 0; will-change: transform;
  }
  .card--1 { background: var(--paper); }
  .card--2 { background: var(--ink); color: var(--white); }
  .card--3 { background: linear-gradient(120deg, #D9E4EA, var(--sky) 40%, var(--blue)); }
  .card--4 { background: var(--navy); color: var(--white); }
  .card--5 { background: var(--white); border: 1px solid #D7D9D9; }
  .card__top { display: flex; justify-content: space-between; font-family: var(--mono); font-size: 11px; letter-spacing: .04em; text-transform: uppercase; opacity: .7; }
  .card__txt { font-size: clamp(28px, 3.6vw, 56px); line-height: 1.08; letter-spacing: -.025em; font-weight: 500; max-width: 22ch; }
  @media (max-width: 767px) {
    .card { top: calc(78px + var(--i) * 12px); padding: 20px 20px 26px; min-height: 340px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .card { transform: none !important; filter: none !important; }
  }
</style>
