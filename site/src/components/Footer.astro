---
import { site, nav } from '../data/site';
const year = new Date().getFullYear();
// Pages with their own call to action at the bottom skip the footer's ask
const hideAsk = ['/contact', '/services'].some((p) => Astro.url.pathname.startsWith(p));
const links = [...nav, { label: 'Contact', href: '/contact/' }];
---
<footer class="f f-a pad">
    <div class="inner">
      {!hideAsk && (
        <div class="a-ask">
          <p class="a-q">Have a project in mind? <span class="accent">Tell us about your business.</span></p>
          <a class="btn btn--light" href="/contact/">Start a project <span aria-hidden="true">↗</span></a>
        </div>
      )}
      <div class="a-cols">
        <div>
          <a class="wm" href="/">{site.wordmark}</a>
          <p class="muted">Creative &amp; digital studio.<br />Design · Technology · Creative · Growth</p>
        </div>
        <nav aria-label="Footer"><p class="label">Pages</p><ul>{links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul></nav>
        <div><p class="label">Contact</p><a class="link-u" href={`mailto:${site.email}`}>{site.email}</a></div>
      </div>
      <p class="base label">© {year} {site.name}</p>
    </div>
  </footer>

<style>
  .wm { font-size: 18px; font-weight: 500; letter-spacing: .42em; line-height: 1; }
  .accent { color: var(--blue); }
  ul { display: flex; flex-direction: column; gap: 8px; }
  li a:hover { text-decoration: underline; text-underline-offset: 4px; }

  /* A — compact dark */
  .f-a { background: var(--ink); color: var(--paper); padding-top: 72px; padding-bottom: 28px; }
  .f-a .label { color: var(--gray); margin-bottom: 12px; }
  .a-ask { display: flex; justify-content: space-between; align-items: center; gap: 32px; padding-bottom: 48px; border-bottom: 1px solid rgba(245,245,242,.14); }
  .a-q { font-size: clamp(22px, 2vw, 30px); line-height: 1.2; letter-spacing: -.015em; font-weight: 500; }
  .a-cols { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 32px; padding-top: 44px; }
  .muted { color: var(--gray); font-size: 13px; line-height: 1.7; margin-top: 16px; }
  .f-a ul { font-size: 14px; }
  .f-a .link-u { font-size: 14px; }
  .f-a .base { margin: 56px 0 0; }

  @media (max-width: 767px) {
    .a-ask { flex-direction: column; align-items: flex-start; }
    .a-cols { grid-template-columns: 1fr 1fr; }
    .a-cols > :first-child { grid-column: 1 / -1; }
  }
</style>
