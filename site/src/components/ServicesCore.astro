---
// Services page: Website Design & Development + Website Management.
// Three designs while choosing: 'c' side by side · 'd' expandable rows · 'e' sticky price, scrolling details.
import { website, management } from '../data/services';
interface Props { variant?: 'c' | 'd' | 'e' }
const { variant = 'c' } = Astro.props;
const quote = (id: string) => `/contact/?service=${id}`;
const svcs = [
  { s: website, no: '01', tag: 'Website', price: `${website.price.lead} ${website.price.amount}`, amt: website.price.amount, lead: website.price.lead, per: '', body: website.body, btn: 'Get a free quote', dark: false },
  { s: management, no: '02', tag: 'After launch', price: `${management.price.amount}${management.price.per}`, amt: management.price.amount, lead: '', per: management.price.per, body: [management.body], btn: 'Ask about management', dark: true },
];
---
{variant === 'c' && (
  <section class="pad section c-wrap" id="web" aria-label="Website and website management">
    <div class="inner c-grid">
      {svcs.map((x, i) => (
        <article class:list={['c-card', { 'c-card--dark on-dark': x.dark }]} id={x.dark ? 'mgmt' : undefined} data-reveal="both" style={`--d:${i * 140}ms`} aria-labelledby={`c-${x.s.id}`}>
          <p class="label">[ {x.no} · {x.tag} ]</p>
          <h2 class="c-name" id={`c-${x.s.id}`}>{x.s.name}</h2>
          <p class="c-price">{x.lead && <span class="c-price__lead">{x.lead}</span>}<span class="c-price__amt">{x.amt}</span>{x.per && <span class="c-price__per">{x.per}</span>}</p>
          <p class="c-lede">{x.s.lede}</p>
          {x.body.map((t) => <p class="c-body">{t}</p>)}
          <p class="label c-inc">{x.s.includesLabel}</p>
          <ul class="c-list">{x.s.includes.map((it) => <li>{it}</li>)}</ul>
          {x.dark && <p class="c-motto">You run the business. <span>We take care of the website.</span></p>}
          <p class="c-note">{x.s.note}</p>
          <a class="c-btn" href={quote(x.s.id)}>{x.btn} <span aria-hidden="true">↗</span></a>
        </article>
      ))}
    </div>
  </section>
)}

{variant === 'd' && (
  <section class="pad section d-wrap" id="web" aria-label="Website and website management">
    <div class="inner">
      <p class="label" data-reveal="both" data-wipe>[ Start here ]</p>
      <div class="d-list">
        {svcs.map((x, i) => (
          <details class="d-row" id={x.dark ? 'mgmt' : undefined} data-reveal="both" style={`--d:${i * 120}ms`} open={i === 0}>
            <summary>
              <span class="d-no">{x.no}</span>
              <span class="d-name">{x.s.name}</span>
              <span class="d-price">{x.price}</span>
              <span class="d-icon" aria-hidden="true"></span>
            </summary>
            <div class="d-body">
              <div>
                <p class="d-lede">{x.s.lede}</p>
                {x.body.map((t) => <p class="d-text">{t}</p>)}
                {x.dark && <p class="d-motto">You run the business. <span>We take care of the website.</span></p>}
              </div>
              <div>
                <p class="label">{x.s.includesLabel}</p>
                <ul class="d-inc">{x.s.includes.map((it) => <li>{it}</li>)}</ul>
              </div>
              <div class="d-side">
                <p class="d-note">{x.s.note}</p>
                <a class="btn btn--solid" href={quote(x.s.id)}>{x.btn} <span aria-hidden="true">↗</span></a>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
)}

{variant === 'e' && svcs.map((x) => (
  <section class:list={['pad', 'section', 'e-sec', { 'e-sec--dark on-dark': x.dark }]} id={x.dark ? 'mgmt' : 'web'} aria-labelledby={`e-${x.s.id}`}>
    <div class="inner e-grid">
      <div class="e-side">
        <p class="label" data-reveal="both" data-wipe>[ {x.no} · {x.tag} ]</p>
        <h2 class="e-name" id={`e-${x.s.id}`} data-reveal="both" data-split>{x.s.name}</h2>
        <p class="e-price" data-reveal="both">{x.lead && <span class="e-price__lead">{x.lead}</span>}<span class="e-price__amt">{x.amt}</span>{x.per && <span class="e-price__per">{x.per}</span>}</p>
        <a class="e-btn" href={quote(x.s.id)} data-reveal="both">{x.btn} <span aria-hidden="true">↗</span></a>
      </div>
      <div class="e-main">
        <p class="e-lede" data-reveal="both" data-split>{x.s.lede}</p>
        {x.body.map((t) => <p class="e-text" data-reveal="both">{t}</p>)}
        <p class="label e-inc" data-reveal="both" data-wipe>{x.s.includesLabel}</p>
        <ul class="e-list">{x.s.includes.map((it, i) => <li data-reveal="both" style={`--d:${(i % 3) * 50}ms`}>{it}</li>)}</ul>
        {x.dark && <p class="e-motto" data-reveal="both" data-split>You run the business. <span class="fade">We take care of the website.</span></p>}
        <p class="e-note" data-reveal="both">{x.s.note}</p>
      </div>
    </div>
  </section>
))}

<style>
  :global(#web), :global(#mgmt), :global(#add), :global(#seo), :global(#pricing) { scroll-margin-top: 90px; }

  /* ---------- C · side by side ---------- */
  .c-wrap { padding-top: 24px; }
  .c-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; align-items: stretch; }
  .c-card { display: flex; flex-direction: column; padding: 36px 36px 40px; background: var(--paper); }
  .c-card--dark { background: var(--ink); color: var(--white); }
  .c-card--dark .label { color: var(--gray); }
  .c-name { margin-top: 18px; font-size: clamp(28px, 2.6vw, 38px); line-height: 1.08; letter-spacing: -.025em; font-weight: 500; }
  .c-price { display: flex; align-items: baseline; gap: 10px; margin: 26px 0 24px; padding-bottom: 24px; border-bottom: 1px solid #DCDDD9; }
  .c-card--dark .c-price { border-color: rgba(255,255,255,.14); }
  .c-price__lead { font-family: var(--mono); font-size: 11px; letter-spacing: .04em; text-transform: uppercase; color: var(--slate); }
  .c-card--dark .c-price__lead, .c-card--dark .c-price__per { color: var(--gray); }
  .c-price__amt { font-size: clamp(56px, 5.4vw, 84px); line-height: .95; letter-spacing: -.04em; font-weight: 500; }
  .c-card--dark .c-price__amt { background: linear-gradient(120deg, #D9E4EA, var(--sky) 45%, var(--blue)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .c-price__per { font-size: 18px; color: var(--slate); }
  .c-lede { font-size: 18px; line-height: 1.4; font-weight: 500; letter-spacing: -.01em; }
  .c-body { font-size: 15px; line-height: 1.6; color: #3C4547; margin-top: 12px; }
  .c-card--dark .c-body { color: rgba(255,255,255,.75); }
  .c-inc { margin-top: 30px; }
  .c-list { list-style: none; display: grid; grid-template-columns: 1fr 1fr; column-gap: 20px; margin-top: 10px; }
  .c-list li { font-size: 14px; padding: 8px 0; border-bottom: 1px solid #DCDDD9; }
  .c-card--dark .c-list li { border-color: rgba(255,255,255,.12); color: rgba(255,255,255,.9); }
  .c-motto { margin-top: 28px; font-size: 22px; line-height: 1.2; font-weight: 500; letter-spacing: -.015em; }
  .c-motto span { color: var(--sky); }
  .c-note { font-size: 13px; color: var(--slate); margin: 18px 0 28px; }
  .c-card--dark .c-note { color: var(--gray); }
  .c-btn { margin-top: auto; align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; min-height: 46px; padding: 0 22px; border-radius: 999px; font-size: 14px; font-weight: 600; background: var(--ink); color: var(--white); }
  .c-card--dark .c-btn { background: var(--sky); color: var(--ink); }
  .c-btn:hover { background: var(--navy); }
  .c-card--dark .c-btn:hover { background: var(--white); }

  /* ---------- D · expandable rows ---------- */
  .d-wrap { padding-top: 24px; }
  .d-list { margin-top: 18px; border-top: 1px solid var(--ink); }
  .d-row { border-bottom: 1px solid var(--ink); }
  .d-row summary { list-style: none; display: grid; grid-template-columns: 56px 1fr auto 44px; align-items: center; gap: 20px; padding: 30px 0; cursor: pointer; }
  .d-row summary::-webkit-details-marker { display: none; }
  .d-no { font-family: var(--mono); font-size: 12px; color: var(--slate); }
  .d-name { font-size: clamp(28px, 4vw, 60px); line-height: 1.02; letter-spacing: -.03em; font-weight: 500; }
  .d-price { font-size: clamp(18px, 1.8vw, 26px); font-weight: 500; letter-spacing: -.01em; white-space: nowrap; }
  .d-icon { width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--ink); position: relative; transition: background var(--t-fast) var(--ease), transform 300ms var(--ease); }
  .d-icon::before, .d-icon::after { content: ''; position: absolute; left: 50%; top: 50%; width: 14px; height: 1.5px; background: currentColor; transform: translate(-50%, -50%); }
  .d-icon::after { transform: translate(-50%, -50%) rotate(90deg); transition: transform 300ms var(--ease); }
  .d-row[open] .d-icon { background: var(--ink); color: var(--white); }
  .d-row[open] .d-icon::after { transform: translate(-50%, -50%) rotate(0deg); }
  .d-row summary:hover .d-name { color: var(--slate); }
  .d-body { display: grid; grid-template-columns: 5fr 5fr 3fr; gap: 48px; padding: 4px 0 40px 76px; animation: d-in 450ms var(--ease); }
  @keyframes d-in { from { opacity: 0; transform: translateY(-8px); } }
  .d-lede { font-size: 19px; line-height: 1.4; font-weight: 500; letter-spacing: -.01em; }
  .d-text { font-size: 15px; line-height: 1.6; color: #3C4547; margin-top: 12px; }
  .d-motto { margin-top: 24px; font-size: 22px; line-height: 1.2; font-weight: 500; letter-spacing: -.015em; }
  .d-motto span { color: var(--blue); }
  .d-inc { list-style: none; margin-top: 10px; }
  .d-inc li { font-size: 14px; padding: 7px 0; border-bottom: 1px solid #E6E7E5; }
  .d-side { display: flex; flex-direction: column; gap: 20px; align-items: flex-start; }
  .d-note { font-size: 13px; color: var(--slate); }

  /* ---------- E · sticky price, scrolling details ---------- */
  .e-sec--dark { background: var(--ink); color: var(--white); }
  .e-sec--dark .label { color: var(--gray); }
  .e-grid { display: grid; grid-template-columns: 5fr 6fr; gap: 80px; align-items: start; }
  .e-side { position: sticky; top: 110px; }
  .e-name { margin-top: 16px; font-size: clamp(34px, 3.6vw, 54px); line-height: 1.04; letter-spacing: -.03em; font-weight: 500; max-width: 13ch; }
  .e-price { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; margin: 30px 0 28px; }
  .e-price__lead { width: 100%; font-family: var(--mono); font-size: 11px; letter-spacing: .04em; text-transform: uppercase; color: var(--slate); }
  .e-price__amt { font-size: clamp(80px, 9vw, 140px); line-height: .9; letter-spacing: -.05em; font-weight: 500; }
  .e-sec--dark .e-price__amt { background: linear-gradient(120deg, #D9E4EA, var(--sky) 45%, var(--blue)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .e-price__per { font-size: 20px; color: var(--slate); }
  .e-sec--dark .e-price__per { color: var(--gray); }
  .e-btn { display: inline-flex; align-items: center; gap: 8px; min-height: 48px; padding: 0 24px; border-radius: 999px; font-size: 14px; font-weight: 600; background: var(--ink); color: var(--white); }
  .e-sec--dark .e-btn { background: var(--sky); color: var(--ink); }
  .e-main { padding-top: 34px; }
  .e-lede { font-size: clamp(24px, 2.4vw, 34px); line-height: 1.2; letter-spacing: -.02em; font-weight: 500; }
  .e-text { font-size: 16px; line-height: 1.65; color: #3C4547; margin-top: 18px; max-width: 58ch; }
  .e-sec--dark .e-text { color: rgba(255,255,255,.75); }
  .e-inc { margin-top: 48px; }
  .e-list { list-style: none; margin-top: 12px; border-top: 1px solid #E1E2DF; }
  .e-list li { font-size: clamp(18px, 1.6vw, 22px); letter-spacing: -.01em; font-weight: 500; padding: 14px 0; border-bottom: 1px solid #E1E2DF; }
  .e-sec--dark .e-list, .e-sec--dark .e-list li { border-color: rgba(255,255,255,.14); }
  .e-motto { margin-top: 56px; font-size: clamp(30px, 3.4vw, 50px); line-height: 1.05; letter-spacing: -.03em; font-weight: 500; }
  .e-motto .fade { color: var(--sky); }
  .e-note { font-size: 13px; color: var(--slate); margin-top: 20px; max-width: 60ch; }
  .e-sec--dark .e-note { color: var(--gray); }

  @media (max-width: 1023px) {
    .c-grid, .e-grid { grid-template-columns: 1fr; gap: 14px; }
    .e-grid { gap: 8px; }
    .e-side { position: static; }
    .d-body { grid-template-columns: 1fr 1fr; padding-left: 0; }
    .d-side { grid-column: 1 / -1; }
  }
  @media (max-width: 767px) {
    .c-card { padding: 26px 20px 32px; margin: 0 calc(var(--side) * -1); }
    .c-list { grid-template-columns: 1fr; }
    .d-row summary { grid-template-columns: 1fr 40px; gap: 8px 12px; padding: 22px 0; }
    .d-no { display: none; }
    .d-name { grid-column: 1; }
    .d-price { grid-column: 1; grid-row: 2; font-size: 16px; color: var(--slate); }
    .d-icon { grid-column: 2; grid-row: 1 / span 2; width: 40px; height: 40px; }
    .d-body { grid-template-columns: 1fr; gap: 28px; }
    .e-price__amt { font-size: 84px; }
  }
</style>
