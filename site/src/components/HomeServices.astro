---
import { homeServices } from '../data/home';
---
<section class="hsv on-dark pad" id="services" aria-labelledby="hsv-h">
  <div class="inner">
    <p class="label" data-reveal>[ Services ]</p>
    <h2 class="hsv__h" id="hsv-h" data-reveal>Your digital presence, built around your business.</h2>
    <div class="hsv__grid">
      {homeServices.map((s, i) => (
        <article class="card" data-reveal style={`--d:${i * 120}ms`}>
          <span class="no">{s.no}</span>
          <h3>{s.name}</h3>
          <ul>{s.items.map((it) => <li>{it}</li>)}</ul>
          <a class="btn-glass" href={`/contact/?service=${s.service}`}>{s.cta} <span aria-hidden="true">↗</span></a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .hsv { position: relative; color: var(--white); padding-top: var(--section); padding-bottom: var(--section);
    background: radial-gradient(900px 520px at 88% 0%, rgba(165,201,225,.26), transparent 62%), radial-gradient(760px 460px at 0% 100%, rgba(120,138,149,.30), transparent 62%), var(--navy); }
  .hsv .label { color: var(--gray); }
  .hsv__h { margin-top: 18px; max-width: 980px; font-size: clamp(30px, 3.6vw, 50px); line-height: 1.08; letter-spacing: -.025em; font-weight: 500;
    background: linear-gradient(110deg, #fff 0%, #cdd7dd 34%, #fff 52%, var(--sky) 80%, #dfe8ee 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .hsv__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-top: 56px; }
  .card { display: flex; flex-direction: column; padding: 34px 32px 36px; border-radius: 26px; border: 1px solid rgba(255,255,255,.20);
    background: linear-gradient(165deg, rgba(255,255,255,.13), rgba(255,255,255,.03)); box-shadow: inset 0 1px 0 rgba(255,255,255,.30), 0 30px 60px rgba(0,0,0,.20);
    -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px); }
  .no { font-family: var(--mono); font-size: 11px; letter-spacing: .06em; color: var(--sky); }
  h3 { margin: 14px 0 24px; font-size: clamp(26px, 2.2vw, 32px); font-weight: 500; letter-spacing: -.02em; line-height: 1.1; }
  ul { margin: 0 0 32px; border-top: 1px solid rgba(255,255,255,.16); }
  li { display: flex; align-items: baseline; gap: 12px; padding: 12px 0; border-bottom: 1px solid rgba(255,255,255,.16); font-size: 15px; }
  li::before { content: ''; flex: 0 0 6px; height: 6px; border-radius: 50%; background: var(--sky); transform: translateY(-2px); }
  .btn-glass { margin-top: auto; align-self: flex-start; }
  @media (max-width: 639px) { .card { padding: 28px 24px 30px; } }
</style>
