---
import Placeholder from './Placeholder.astro';
interface Slide { tone: 'a' | 'b' | 'c'; note: string }
interface Props { title: string; subtitle: string; cta: { label: string; href: string }; slides: Slide[] }
const { title, subtitle, cta, slides } = Astro.props;
---
<section class="hero on-dark" aria-roledescription="carousel" aria-label="Featured" data-hero>
  <div class="slides">
    {slides.map((s, i) => (
      <div class:list={['slide', { 'is-active': i === 0 }]} aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}`} aria-hidden={i === 0 ? undefined : 'true'} data-slide>
        <Placeholder tone={s.tone} note={s.note} class="slide__media" />
      </div>
    ))}
  </div>
  <div class="shade" aria-hidden="true"></div>
  <div class="cap">
    <h1 class="title">{title}</h1>
    <p class="sub">{subtitle}</p>
    <a class="btn btn--light" href={cta.href}>{cta.label}</a>
  </div>
  <div class="controls">
    <div class="bars" role="group" aria-label="Choose slide">
      {slides.map((_, i) => (
        <button type="button" class="bar" aria-label={`Show slide ${i + 1}`} aria-current={i === 0 ? 'true' : undefined} data-goto={i}><span></span></button>
      ))}
    </div>
    <button type="button" class="pause label" data-pause aria-pressed="false">Pause</button>
  </div>
</section>

<style>
  .hero { position: relative; height: 88vh; min-height: 640px; color: var(--white); overflow: hidden; background: var(--navy); }
  .slides, .slide, .slide :global(.slide__media) { position: absolute; inset: 0; }
  .slide { opacity: 0; transition: opacity 600ms var(--ease); }
  .slide.is-active { opacity: 1; }
  .slide :global(.ph__note) { top: 96px; bottom: auto; left: var(--side); right: var(--side); }
  .shade { position: absolute; inset: 0; background: linear-gradient(to top, rgba(31,38,39,.55), rgba(31,38,39,.05) 50%, rgba(31,38,39,.25)); pointer-events: none; }
  .cap { position: absolute; left: 50%; bottom: 120px; transform: translateX(-50%); width: min(90%, 760px); text-align: center; }
  .title { font-size: 30px; font-weight: 500; letter-spacing: .3em; margin-right: -.3em; line-height: 1.15; text-transform: uppercase; }
  .sub { font-size: 15px; margin: 12px 0 26px; opacity: .92; }
  .controls { position: absolute; left: 0; right: 0; bottom: 30px; display: flex; justify-content: center; align-items: center; gap: 20px; }
  .bars { display: flex; gap: 10px; }
  .bar { width: 100px; height: 24px; background: none; border: 0; cursor: pointer; display: flex; align-items: center; padding: 0; }
  .bar span { display: block; width: 100%; height: 1px; background: rgba(255,255,255,.45); position: relative; overflow: hidden; }
  .bar span::after { content: ''; position: absolute; inset: 0; background: var(--white); transform: scaleX(0); transform-origin: left; }
  .bar[aria-current="true"] span::after { transform: scaleX(1); transition: transform var(--dur, 6s) linear; }
  .hero.is-paused .bar[aria-current="true"] span::after, .hero.no-auto .bar[aria-current="true"] span::after { transition: none; }
  .pause { position: absolute; right: var(--side); background: none; border: 0; color: rgba(255,255,255,.8); cursor: pointer; min-height: 44px; }
  .pause:hover { color: var(--white); }
  @media (max-width: 639px) {
    .hero { height: 80vh; min-height: 540px; }
    .cap { bottom: 96px; }
    .title { font-size: 22px; }
    .bar { width: 44px; }
    .pause { position: static; }
    .controls { bottom: 22px; }
  }
</style>
