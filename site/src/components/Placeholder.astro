---
// Stand-in for a real image or video until assets are supplied.
interface Props { tone?: 'a' | 'b' | 'c'; note: string; class?: string; clip?: boolean }
const { tone = 'a', note, class: cls, clip = false } = Astro.props;
---
<div class:list={['ph', tone !== 'a' && `ph--${tone}`, cls]} role="img" aria-label={`Placeholder: ${note}`} data-clip={clip ? '' : undefined}>
  <span class="ph__note" aria-hidden="true">Placeholder · {note}</span>
</div>
