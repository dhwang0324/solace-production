---
// Services page: intro, Website Design & Development, Website Management.
// Two designs while choosing: 'a' editorial index · 'b' modular build.
import { website, management } from '../data/services';
interface Props { variant?: 'a' | 'b' }
const { variant = 'a' } = Astro.props;
const quote = (id: string) => `/contact/?service=${id}`;
const toc = [
  { href: '#web', no: '01', name: 'Website design & development', meta: 'Starting at $500' },
  { href: '#mgmt', no: '02', name: 'Website management', meta: '$100/month' },
  { href: '#add', no: '03', name: 'Creative add-ons', meta: 'Custom quote' },
  { href: '#seo', no: '04', name: 'SEO & digital growth', meta: 'Basic SEO included' },
  { href: '#pricing', no: '05', name: 'How pricing works', meta: 'All prices' },
];
const mods = [
  { href: '#mgmt', name: 'Website management', meta: '$100/month' },
  { href: '#add', name: 'Photography', meta: 'Custom quote' },
  { href: '#add', name: 'Videography', meta: 'Custom quote' },
  { href: '#add', name: 'E-commerce', meta: 'Custom quote' },
  { href: '#seo', name: 'SEO & growth', meta: 'Custom quote' },
  { href: '#add', name: 'Custom features', meta: 'Custom quote' },
];
const no = (i: number) => String(i + 1).padStart(2, '0');
---
{variant === 'a' && (
  <>
    <!-- A · Intro: big statement and an index of the page -->
    <section class="pad a-head">
      <div class="inner">
        <p class="label" data-reveal="both" data-wipe>[ Services ]</p>
        <h1 class="a-display" data-reveal="both" data-split>Your digital presence, <span class="fade">built around your business.</span></h1>
        <div class="a-head__row">
          <p class="body-l" data-reveal="both" style="--d:120ms">Every business needs something different. Solace starts with a thoughtfully designed website and gives you the option to add the creative and digital services your business actually needs.</p>
          <p class="a-strong" data-reveal="both" style="--d:200ms">No unnecessary packages. <span class="fade">No paying for services you won’t use.</span></p>
        </div>
        <nav class="toc" aria-label="On this page">
          {toc.map((t, i) => (
            <a href={t.href} data-reveal="both" data-rise style={`--d:${i * 70}ms`}>
              <span class="toc__no">{t.no}</span>
              <span class="toc__name">{t.name}</span>
              <span class="toc__meta">{t.meta} <span aria-hidden="true">↓</span></span>
            </a>
          ))}
        </nav>
      </div>
    </section>

    <!-- A · Website: headline and price card, then a spec sheet of what's included -->
    <section class="pad section a-web" id="web" aria-labelledby="web-h">
      <div class="inner">
        <div class="a-web__top">
          <div>
            <p class="label" data-reveal="both" data-wipe>[ 01 · Website ]</p>
            <h2 class="a-title" id="web-h" data-reveal="both" data-split>{website.name}</h2>
            <p class="a-lede" data-reveal="both">{website.lede}</p>
          </div>
          <div class="a-price" data-reveal="both" data-rise style="--d:150ms">
            <p class="label">{website.price.lead}</p>
            <p class="a-price__amt">{website.price.amount}</p>
            <a class="a-price__btn" href={quote(website.id)}>Get a free quote <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <div class="a-cols">
          {website.body.map((t, i) => <p class="body-l" data-reveal="both" style={`--d:${i * 100}ms`}>{t}</p>)}
        </div>
        <p class="label a-spec__label" data-reveal="both" data-wipe>{website.includesLabel}</p>
        <ol class="spec">
          {website.includes.map((it, i) => (
            <li data-reveal="both" style={`--d:${(i % 5) * 60}ms`}><span class="spec__no">{no(i)}</span><span class="spec__txt">{it}</span></li>
          ))}
        </ol>
        <p class="a-note" data-reveal="both">{website.note}</p>
      </div>
    </section>

    <!-- A · Management: the price large on the left, everything covered on the right -->
    <section class="pad section a-mgmt on-dark" id="mgmt" aria-labelledby="mgmt-h">
      <div class="inner">
        <div class="a-mgmt__grid">
          <div>
            <p class="label" data-reveal="both" data-wipe>[ 02 · After launch ]</p>
            <h2 class="a-title" id="mgmt-h" data-reveal="both" data-split>{management.name}</h2>
            <p class="a-big" data-reveal="both"><span>{management.price.amount}</span><small>{management.price.per}</small></p>
            <p class="a-lede" data-reveal="both">{management.lede}</p>
            <p class="body-l" data-reveal="both">{management.body}</p>
            <a class="a-price__btn a-price__btn--light" href={quote(management.id)} data-reveal="both">Ask about management <span aria-hidden="true">↗</span></a>
          </div>
          <div>
            <p class="label" data-reveal="both" data-wipe>{management.includesLabel}</p>
            <ul class="checks">
              {management.includes.map((it, i) => <li data-reveal="both" style={`--d:${(i % 2) * 70}ms`}>{it}</li>)}
            </ul>
          </div>
        </div>
        <div class="a-mgmt__end">
          <p class="a-motto" data-reveal="both" data-split>You run the business. <span class="fade">We take care of the website.</span></p>
          <p class="a-note a-note--dark" data-reveal="both">{management.note}</p>
        </div>
      </div>
    </section>
  </>
)}

{variant === 'b' && (
  <>
    <!-- B · Intro: the model drawn as building blocks -->
    <section class="pad b-head">
      <div class="inner">
        <div class="b-head__text">
          <p class="label" data-reveal="both" data-wipe>[ Services ]</p>
          <h1 class="statement" data-reveal="both" data-split>Your digital presence, <span class="fade">built around your business.</span></h1>
          <p class="body-l" data-reveal="both" style="--d:120ms">Every business needs something different. Solace starts with a thoughtfully designed website and gives you the option to add the creative and digital services your business actually needs.</p>
          <p class="b-strong" data-reveal="both" style="--d:200ms">No unnecessary packages. <span class="fade">No paying for services you won’t use.</span></p>
        </div>
        <div class="build" aria-label="How Solace services fit together">
          <a class="build__base" href="#web" data-reveal="both" data-rise>
            <span class="label">Start with</span>
            <span class="build__name">Website design &amp; development</span>
            <span class="build__meta">Starting at $500</span>
          </a>
          <p class="build__plus" data-reveal="both" style="--d:200ms"><span aria-hidden="true">+</span> Add only what you need</p>
          <ul class="build__mods">
            {mods.map((m, i) => (
              <li data-reveal="both" data-rise style={`--d:${300 + i * 80}ms`}><a href={m.href}><span class="build__mname">{m.name}</span><span class="build__mmeta">{m.meta}</span></a></li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- B · Website: one card with everything, including the quote button -->
    <section class="pad section b-web" id="web" aria-labelledby="web-h">
      <div class="inner">
        <p class="label" data-reveal="both" data-wipe>[ 01 · The foundation ]</p>
        <div class="b-card" data-reveal="both">
          <div class="b-card__main">
            <h2 class="h2" id="web-h" data-split>{website.name}</h2>
            <p class="b-price"><span class="b-price__lead">{website.price.lead}</span><span class="b-price__amt">{website.price.amount}</span></p>
            <p class="b-lede">{website.lede}</p>
            {website.body.map((t) => <p class="body-l">{t}</p>)}
            <a class="btn btn--solid b-card__btn" href={quote(website.id)}>Get a free quote <span aria-hidden="true">↗</span></a>
          </div>
          <div class="b-card__list">
            <p class="label">{website.includesLabel}</p>
            <ul class="b-ticks">{website.includes.map((i) => <li>{i}</li>)}</ul>
            <p class="b-note">{website.note}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- B · Management: "You" and "We" side by side -->
    <section class="pad section b-mgmt on-dark" id="mgmt" aria-labelledby="mgmt-h">
      <div class="inner">
        <div class="b-mgmt__head">
          <div>
            <p class="label" data-reveal="both" data-wipe>[ 02 · After launch ]</p>
            <h2 class="h2" id="mgmt-h" data-reveal="both" data-split>{management.name}</h2>
            <p class="b-mgmt__lede" data-reveal="both">{management.lede} {management.body}</p>
          </div>
          <p class="b-pill" data-reveal="both" data-rise><span class="b-pill__amt">{management.price.amount}</span><span>{management.price.per}</span></p>
        </div>
        <div class="split">
          <div class="split__you" data-reveal="both">
            <p class="label">You</p>
            <p class="split__big">Run the business.</p>
          </div>
          <div class="split__we" data-reveal="both" style="--d:150ms">
            <p class="label">We take care of the website</p>
            <ul class="b-ticks b-ticks--3">{management.includes.map((i) => <li>{i}</li>)}</ul>
          </div>
        </div>
        <p class="b-note b-note--dark" data-reveal="both">{management.note}</p>
      </div>
    </section>
  </>
)}

<style>
  :global(#web), :global(#mgmt), :global(#add), :global(#seo), :global(#pricing) { scroll-margin-top: 90px; }
  .body-l { color: #3C4547; }
  .on-dark .body-l { color: rgba(255,255,255,.78); }

  /* ---------- A ---------- */
  .a-head { padding-top: 72px; padding-bottom: 56px; }
  .a-display { margin-top: 16px; font-size: clamp(40px, 6vw, 92px); line-height: 1.02; letter-spacing: -.035em; font-weight: 500; max-width: 21ch; }
  .a-display .fade { color: var(--blue); }
  .a-head__row { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; margin-top: 44px; max-width: 1180px; align-items: start; }
  .a-strong { font-size: clamp(20px, 1.8vw, 26px); line-height: 1.3; letter-spacing: -.01em; font-weight: 500; }
  .a-strong .fade { color: var(--blue); }
  .toc { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; margin-top: 64px; }
  .toc a { display: flex; flex-direction: column; gap: 10px; min-height: 132px; padding: 14px 16px 16px; border: 1px solid #D7D9D9; background: var(--white); transition: background var(--t-fast) var(--ease), color var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease); }
  .toc__no { font-family: var(--mono); font-size: 11px; color: var(--slate); }
  .toc__name { font-size: 17px; font-weight: 500; letter-spacing: -.01em; line-height: 1.25; }
  .toc__meta { margin-top: auto; font-family: var(--mono); font-size: 11px; letter-spacing: .04em; text-transform: uppercase; color: var(--slate); }
  .toc a:hover { background: var(--ink); border-color: var(--ink); color: var(--white); }
  .toc a:hover .toc__no, .toc a:hover .toc__meta { color: var(--sky); }

  .a-web { border-top: 1px solid #E6E7E5; }
  .a-web__top { display: grid; grid-template-columns: 1fr 360px; gap: 64px; align-items: end; }
  .a-title { margin-top: 14px; font-size: clamp(34px, 3.8vw, 56px); line-height: 1.05; letter-spacing: -.03em; font-weight: 500; max-width: 16ch; }
  .a-lede { font-size: 19px; line-height: 1.4; font-weight: 500; letter-spacing: -.01em; margin-top: 18px; max-width: 46ch; }
  .a-price { background: var(--paper); padding: 22px 24px 24px; display: grid; gap: 6px; }
  .a-price__amt { font-size: clamp(64px, 6vw, 88px); line-height: .95; letter-spacing: -.04em; font-weight: 500; margin-bottom: 14px; }
  .a-price__btn { display: inline-flex; justify-content: center; align-items: center; gap: 8px; min-height: 48px; padding: 0 22px; border-radius: 999px; background: var(--ink); color: var(--white); font-size: 14px; font-weight: 600; transition: background var(--t-fast) var(--ease); }
  .a-price__btn:hover { background: var(--navy); }
  .a-price__btn--light { background: var(--sky); color: var(--ink); margin-top: 26px; width: fit-content; }
  .a-price__btn--light:hover { background: var(--white); }
  .a-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; margin-top: 44px; max-width: 1180px; }
  .a-spec__label { margin-top: 64px; }
  .spec { list-style: none; display: grid; grid-template-columns: repeat(5, 1fr); margin-top: 14px; border-top: 1px solid #D7D9D9; border-left: 1px solid #D7D9D9; }
  .spec li { display: flex; flex-direction: column; justify-content: space-between; gap: 22px; min-height: 120px; padding: 14px 16px 16px; border-right: 1px solid #D7D9D9; border-bottom: 1px solid #D7D9D9; }
  .spec__no { font-family: var(--mono); font-size: 11px; color: var(--slate); }
  .spec__txt { font-size: 16px; font-weight: 500; letter-spacing: -.01em; line-height: 1.3; }
  .a-note { font-size: 13px; color: var(--slate); margin-top: 16px; max-width: 60ch; }

  .a-mgmt { background: var(--ink); color: var(--white); }
  .a-mgmt .label { color: var(--gray); }
  .a-mgmt__grid { display: grid; grid-template-columns: 5fr 6fr; gap: 80px; align-items: start; }
  .a-big { display: flex; align-items: baseline; gap: 10px; margin: 24px 0 8px; }
  .a-big span { font-size: clamp(88px, 10vw, 150px); line-height: .9; letter-spacing: -.05em; font-weight: 500; background: linear-gradient(120deg, #D9E4EA, var(--sky) 45%, var(--blue)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .a-big small { font-size: 20px; color: var(--gray); }
  .a-mgmt .body-l { margin-top: 10px; max-width: 52ch; }
  .checks { list-style: none; display: grid; grid-template-columns: 1fr 1fr; column-gap: 28px; margin-top: 14px; border-top: 1px solid rgba(255,255,255,.14); }
  .checks li { display: flex; gap: 12px; align-items: baseline; padding: 13px 0; border-bottom: 1px solid rgba(255,255,255,.14); font-size: 15px; color: rgba(255,255,255,.9); }
  .checks li::before { content: '✓'; font-size: 12px; color: var(--sky); }
  .a-mgmt__end { margin-top: 88px; padding-top: 40px; border-top: 1px solid rgba(255,255,255,.14); display: grid; grid-template-columns: 7fr 4fr; gap: 64px; align-items: end; }
  .a-motto { font-size: clamp(32px, 4.4vw, 64px); line-height: 1.04; letter-spacing: -.03em; font-weight: 500; }
  .a-motto .fade { color: var(--sky); }
  .a-note--dark { color: var(--gray); margin-top: 0; }

  /* ---------- B ---------- */
  .b-head { padding-top: 72px; padding-bottom: 88px; }
  .b-head .inner { display: grid; grid-template-columns: 5fr 6fr; gap: 72px; align-items: center; }
  .b-head .statement { margin-top: 14px; }
  .b-head .body-l { margin-top: 24px; max-width: 52ch; }
  .b-strong { margin-top: 18px; font-size: 19px; font-weight: 500; letter-spacing: -.01em; }
  .b-strong .fade { color: var(--blue); }
  .build { display: grid; gap: 12px; }
  .build__base { display: grid; gap: 8px; padding: 26px 28px 28px; background: var(--ink); color: var(--white); transition: background var(--t-fast) var(--ease); }
  .build__base .label { color: var(--sky); }
  .build__base:hover { background: var(--navy); }
  .build__name { font-size: clamp(24px, 2.4vw, 34px); line-height: 1.1; letter-spacing: -.02em; font-weight: 500; }
  .build__meta { font-size: 16px; color: var(--sky); }
  .build__plus { font-family: var(--mono); font-size: 11px; letter-spacing: .04em; text-transform: uppercase; color: var(--slate); display: flex; align-items: center; gap: 10px; padding: 4px 0; }
  .build__plus span { display: inline-grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; border: 1px solid var(--slate); font-size: 14px; }
  .build__mods { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .build__mods a { display: flex; flex-direction: column; gap: 6px; min-height: 92px; padding: 14px 16px; border: 1px dashed #B9BDBD; background: var(--white); transition: border-color var(--t-fast) var(--ease), background var(--t-fast) var(--ease); }
  .build__mods a:hover { border-style: solid; border-color: var(--ink); background: var(--paper); }
  .build__mname { font-size: 15px; font-weight: 500; }
  .build__mmeta { margin-top: auto; font-family: var(--mono); font-size: 10.5px; letter-spacing: .04em; text-transform: uppercase; color: var(--slate); }

  .b-web { background: var(--paper); }
  .b-card { margin-top: 20px; background: var(--white); display: grid; grid-template-columns: 1fr 1fr; }
  .b-card__main { padding: 40px; }
  .b-card__list { padding: 40px; border-left: 1px solid #E6E7E5; }
  .b-price { display: flex; align-items: baseline; gap: 12px; margin: 22px 0 22px; }
  .b-price__lead { font-family: var(--mono); font-size: 11px; letter-spacing: .04em; text-transform: uppercase; color: var(--slate); }
  .b-price__amt { font-size: clamp(56px, 5vw, 76px); line-height: 1; letter-spacing: -.04em; font-weight: 500; }
  .b-lede { font-size: 19px; line-height: 1.4; font-weight: 500; letter-spacing: -.01em; margin-bottom: 12px; }
  .b-card__main .body-l { margin-top: 12px; }
  .b-card__btn { margin-top: 28px; }
  .b-ticks { list-style: none; display: grid; grid-template-columns: 1fr 1fr; column-gap: 24px; margin-top: 14px; }
  .b-ticks li { display: flex; gap: 10px; align-items: baseline; padding: 11px 0; border-bottom: 1px solid #E6E7E5; font-size: 15px; }
  .b-ticks li::before { content: '✓'; font-size: 12px; color: var(--slate); }
  .b-note { font-size: 13px; color: var(--slate); margin-top: 18px; }

  .b-mgmt { background: var(--ink); color: var(--white); }
  .b-mgmt .label { color: var(--gray); }
  .b-mgmt__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 40px; flex-wrap: wrap; }
  .b-mgmt .h2 { margin-top: 14px; }
  .b-mgmt__lede { margin-top: 16px; font-size: 16px; line-height: 1.6; color: rgba(255,255,255,.78); max-width: 62ch; }
  .b-pill { display: inline-flex; align-items: baseline; gap: 6px; padding: 14px 26px; border-radius: 999px; background: linear-gradient(120deg, #D9E4EA, var(--sky) 55%, #C9DCEA); color: var(--ink); font-size: 18px; font-weight: 500; }
  .b-pill__amt { font-size: 40px; letter-spacing: -.03em; line-height: 1; }
  .split { display: grid; grid-template-columns: 4fr 7fr; margin-top: 56px; border-top: 1px solid rgba(255,255,255,.14); }
  .split__you { padding: 32px 40px 32px 0; border-right: 1px solid rgba(255,255,255,.14); }
  .split__big { font-size: clamp(34px, 4vw, 60px); line-height: 1.04; letter-spacing: -.03em; font-weight: 500; margin-top: 12px; }
  .split__we { padding: 32px 0 32px 40px; }
  .split__we .label { color: var(--sky); }
  .b-ticks--3 { grid-template-columns: repeat(3, 1fr); }
  .on-dark .b-ticks li { border-color: rgba(255,255,255,.14); color: rgba(255,255,255,.9); }
  .on-dark .b-ticks li::before { color: var(--sky); }
  .b-note--dark { color: var(--gray); border-top: 1px solid rgba(255,255,255,.14); padding-top: 20px; margin-top: 0; }

  @media (max-width: 1023px) {
    .toc { grid-template-columns: repeat(3, 1fr); }
    .spec { grid-template-columns: repeat(3, 1fr); }
    .a-mgmt__grid, .a-mgmt__end, .b-head .inner { grid-template-columns: 1fr; gap: 44px; }
    .b-ticks--3 { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 767px) {
    .a-head__row, .a-cols, .a-web__top, .b-card, .split { grid-template-columns: 1fr; gap: 28px; }
    .toc { grid-template-columns: 1fr 1fr; margin-top: 44px; }
    .toc a { min-height: 112px; }
    .spec { grid-template-columns: 1fr 1fr; }
    .spec li { min-height: 96px; }
    .checks, .b-ticks, .b-ticks--3 { grid-template-columns: 1fr; }
    .a-mgmt__end { margin-top: 56px; }
    .build__mods { grid-template-columns: 1fr 1fr; }
    .b-card__main, .b-card__list { padding: 24px 20px; }
    .b-card__list { border-left: 0; border-top: 1px solid #E6E7E5; }
    .split__you { padding: 24px 0; border-right: 0; border-bottom: 1px solid rgba(255,255,255,.14); }
    .split__we { padding: 24px 0; }
  }
</style>
