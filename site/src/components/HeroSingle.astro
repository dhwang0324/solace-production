---
// One full banner with a looping video and a rotating theme word (Design → Technology → Creative → Growth).
// Centred title with the rotating word underneath.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  poster: ImageMetadata;
  video: { mp4: string; webm?: string };
  words: string[];
  cta: { label: string; href: string };
}
const { poster, video, words, cta } = Astro.props;
---
<section class="hs on-dark" aria-label="Introduction" data-hero data-hero-single>
  <div class="hs__frame">
    <div class="hs__media">
      <Picture src={poster} alt="" formats={['avif', 'webp']} fallbackFormat="jpg" widths={[960, 1440, 1920, 2560].filter((w) => w <= poster.width)} sizes="100vw" loading="eager" fetchpriority="high" class="hs__img" />
      <video class="hs__video" muted loop playsinline preload="none" aria-hidden="true" data-hs-video>
        {video.webm && <source src={video.webm} type="video/webm" />}
        <source src={video.mp4} type="video/mp4" />
      </video>
    </div>
    <div class="hs__shade" aria-hidden="true"></div>

    <div class="hs__copy">
      <h1 class="hs__title">Digital Presence</h1>
      <p class="hs__line">
        <span class="sr-only">{words.join(', ')} — thoughtfully built.</span>
        <span class="hs__words" aria-hidden="true" data-hs-words>
          {words.map((w, i) => <span class:list={['hs__word', { 'is-on': i === 0 }]}>{w}</span>)}
        </span>
        <span class="hs__rest" aria-hidden="true">— thoughtfully built.</span>
      </p>
      <a class="btn btn--light hs__cta" href={cta.href}>{cta.label}</a>
    </div>

    <button type="button" class="hs__pause label" data-hs-pause aria-pressed="false">Pause</button>
  </div>
</section>

<style>
  .hs { position: relative; color: var(--white); }
  .hs__frame { position: relative; height: 92vh; min-height: 600px; overflow: hidden; background: var(--navy); }
  .hs__media, .hs__media :global(picture), .hs__media :global(.hs__img), .hs__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hs__video { opacity: 0; transition: opacity 800ms var(--ease); }
  .hs__video.is-playing { opacity: 1; }
  .hs__shade { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(to top, rgba(31,38,39,.66), rgba(31,38,39,.12) 55%, rgba(31,38,39,.28)); }
  .hs__title { font-weight: 500; text-transform: uppercase; line-height: 1.1; }

  /* Rotating word: the current word rises in, the last one rises out */
  .hs__words { display: inline-grid; vertical-align: bottom; overflow: hidden; }
  .hs__word { grid-area: 1 / 1; transform: translateY(100%); opacity: 0; transition: transform 600ms var(--ease), opacity 600ms var(--ease); white-space: nowrap; }
  .hs__word.is-on { transform: none; opacity: 1; }
  .hs__word.is-out { transform: translateY(-100%); opacity: 0; }

  .hs__pause { position: absolute; right: var(--side); bottom: 30px; background: none; border: 0; color: rgba(255,255,255,.85); cursor: pointer; min-height: 44px; }
  .hs__pause:hover { color: var(--white); }

  /* Centred copy */
  .hs__copy { position: absolute; left: 50%; bottom: 112px; transform: translateX(-50%); width: min(90%, 820px); text-align: center; }
  .hs__title { font-size: clamp(26px, 2.6vw, 38px); letter-spacing: .3em; margin-right: -.3em; }
  .hs__line { font-size: 17px; margin: 14px 0 28px; display: flex; justify-content: center; gap: 8px; }
  .hs__words { font-weight: 600; }

  @media (max-width: 639px) {
    .hs__frame { height: 86vh; min-height: 540px; }
    .hs__copy { bottom: 92px; }
    .hs__line { font-size: 15px; flex-wrap: wrap; }
    .hs__pause { bottom: 18px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hs__video { display: none; }
  }
</style>
