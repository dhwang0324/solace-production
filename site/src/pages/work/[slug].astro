---
import Base from '../../layouts/Base.astro';
import Placeholder from '../../components/Placeholder.astro';
import { projects, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}
const { project } = Astro.props as { project: Project };
const idx = projects.findIndex((p) => p.slug === project.slug);
const next = projects[(idx + 1) % projects.length];
const sections = [
  ['Challenge', project.challenge],
  ['Strategy', project.strategy],
  ['Design', project.design],
  ['Development', project.development],
  ['Photography & content', project.content],
  ['Results', project.results],
].filter(([, v]) => v) as [string, string][];
const facts = [
  ['Client', project.client],
  ['Industry', project.industry],
  project.services?.length ? ['Services', project.services.join(', ')] : null,
  project.year ? ['Year', String(project.year)] : null,
].filter(Boolean) as [string, string][];
---
<Base title={project.client} description={project.summary ?? `${project.client} — a Solace project.`}>
  <section class="pad head">
    <div class="inner">
      <p class="label"><a href="/work/" class="link-u">Work</a> / {project.client}</p>
      <h1 class="title">{project.client}</h1>
      {project.summary && <p class="statement summary">{project.summary}</p>}
    </div>
  </section>
  <Placeholder tone={project.tone} note={`${project.client} · full-width project image`} class="lead-media" clip />
  <section class="pad facts-wrap">
    <dl class="inner facts">
      {facts.map(([k, v]) => <div><dt class="label">{k}</dt><dd>{v}</dd></div>)}
      {project.website && <div><dt class="label">Website</dt><dd><a class="link-u" href={project.website} rel="noopener" target="_blank">{project.website.replace(/^https?:\/\//, '').replace(/\/$/, '')}</a></dd></div>}
    </dl>
  </section>
  <section class="pad body">
    <div class="inner">
      {sections.length ? sections.map(([h, t]) => (
        <div class="row" data-reveal><h2 class="label">[ {h} ]</h2><p class="body-l measure">{t}</p></div>
      )) : (
        <div class="row"><h2 class="label">[ Case study ]</h2><p class="body-l measure">The full case study for {project.client} is being written. In the meantime, get in touch to hear about the project.</p></div>
      )}
      <div class="gallery">
        <Placeholder tone="c" note="Project image · 16:10" clip />
        <Placeholder tone={project.tone} note="Project image · 4:5" clip />
      </div>
    </div>
  </section>
  {projects.length > 1 && (
    <a class="next pad" href={`/work/${next.slug}/`}>
      <span class="inner"><span class="label">Next project</span><span class="next-name">{next.client} <span aria-hidden="true">→</span></span></span>
    </a>
  )}
</Base>

<style>
  .head { padding-top: 72px; padding-bottom: 48px; }
  .title { font-size: clamp(44px, 7vw, 112px); font-weight: 500; letter-spacing: -.04em; line-height: .95; margin-top: 18px; }
  .summary { margin-top: 24px; max-width: 900px; }
  :global(.lead-media) { height: clamp(420px, 60vw, 820px); }
  .facts-wrap { border-bottom: 1px solid #E6E7E5; }
  .facts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; padding: 28px 0; }
  .facts dd { margin-top: 6px; font-size: 15px; }
  .body { padding-top: 72px; padding-bottom: var(--section); }
  .row { display: grid; grid-template-columns: 1fr 2fr; gap: 40px; padding: 28px 0; border-top: 1px solid #ECEDEB; }
  .gallery { display: grid; grid-template-columns: 7fr 5fr; gap: 16px; margin-top: 56px; }
  .gallery :global(.ph) { height: clamp(360px, 40vw, 640px); }
  .next { display: block; background: var(--paper); padding-top: 64px; padding-bottom: 64px; }
  .next .inner { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
  .next-name { font-size: clamp(28px, 4vw, 56px); font-weight: 500; letter-spacing: -.03em; }
  .next:hover .next-name { color: var(--slate); }
  @media (max-width: 767px) {
    .facts { grid-template-columns: 1fr 1fr; }
    .row { grid-template-columns: 1fr; gap: 10px; }
    .gallery { grid-template-columns: 1fr; }
    .next .inner { flex-direction: column; }
  }
</style>
