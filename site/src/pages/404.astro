---
import Base from '../layouts/Base.astro';
import Mascot from '../components/Mascot.astro';
---
<Base title="Page not found">
  <section class="pad section">
    <div class="inner">
      <p class="label">[ 404 ]</p>
      <h1 class="statement">This page doesn’t exist. <span class="fade">Try the <a class="link-u" href="/work/">work</a> or go <a class="link-u" href="/">home</a>.</span></h1>
      <Mascot name="walk" width={150} class="lost" />
    </div>
  </section>
</Base>

<style>
  :global(.lost) { margin-top: 36px; }
</style>
