---
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import Beliefs from '../components/Beliefs.astro';

const motto = 'Technology makes us faster. The human eye decides what’s good.';
const approach = ['Better tools.', 'More efficient process.', 'Less unnecessary cost.', 'High creative standards.'];
const beliefs = [
  'Great digital design shouldn’t feel inaccessible.',
  'Businesses shouldn’t spend thousands only to receive something that already feels outdated.',
  'Technology should make the creative process more efficient — not replace creativity.',
  'AI can generate possibilities. Human judgment determines what deserves to exist.',
  'A business’s digital presence should be as considered as the business itself.',
];
---
<Base title="Studio" description="Solace combines modern technology with human creative direction to build a digital presence worthy of the business behind it.">
  <section class="pad head">
    <div class="inner">
      <p class="label" data-reveal="both">[ The studio ]</p>
      <h1 class="statement" data-reveal="both" data-split style="--d:80ms">A digital presence <span class="fade">worthy of the business behind it.</span></h1>
      <p class="body-l intro measure" data-reveal="both" style="--d:160ms">Solace builds digital experiences that feel modern, intentional and distinctive, using better tools and a high creative standard.</p>
    </div>
  </section>

  <div class="media-wrap"><Placeholder tone="c" note="Studio image · full width" class="studio-media" clip /></div>

  <!-- Why Solace exists -->
  <section class="pad section" aria-labelledby="why-h">
    <div class="inner sec sec--c">
      <div class="sec__side"><p class="label" id="why-h" data-reveal="both">[ 01 · Why Solace exists ]</p></div>
      <div class="sec__head">
        <p class="statement" data-reveal="both" data-split>Businesses can spend thousands on websites that still feel outdated, generic or disconnected from the business itself. <span class="fade">We believe businesses deserve better.</span></p>
      </div>
      <div class="sec__body cols">
          <p class="body-l" data-reveal="both">Solace was created from a frustration with the traditional website industry. Too often, the quality of the website doesn’t match the quality of the business behind it.</p>
          <p class="body-l" data-reveal="both" style="--d:120ms">A modern, thoughtfully designed website shouldn’t require unnecessary cost or complexity. We use modern technology to make the process more efficient while keeping a high standard for creativity and design.</p>
      </div>
    </div>
  </section>

  <!-- AI + human creative direction -->
  <section class="pad section dark on-dark" aria-labelledby="ai-h">
    <div class="inner">
      <p class="label" id="ai-h" data-reveal="both">[ 02 · AI + human creative direction ]</p>
      <p class="motto" data-words>
        {motto.split(' ').map((w, i) => <><span class="w">{w}</span>{i < motto.split(' ').length - 1 && ' '}</>)}
      </p>
      <p class="body-l lede measure" data-reveal="both">Technology is an important part of how Solace works, but it isn’t a replacement for creative judgment. We combine AI and emerging technology with human creative direction, design judgment and attention to detail.</p>
      <div class="split">
        <div class="side" data-reveal="both">
          <span class="bar"><span class="no">A</span> Technology</span>
          <p>Helps us explore ideas, iterate faster and make the development process more efficient.</p>
        </div>
        <div class="side" data-reveal="both" style="--d:120ms">
          <span class="bar bar--light"><span class="no">B</span> The human eye</span>
          <p>Decides what actually looks good, what feels intentional and what properly represents the business.</p>
        </div>
      </div>
      <p class="goal" data-reveal="both" data-split>The goal isn’t websites that look AI-generated. <span class="fade">It’s better tools, producing better work.</span></p>
    </div>
  </section>

  <!-- What Solace wants to accomplish -->
  <section class="band pad section" aria-labelledby="goal-h">
    <div class="inner">
      <p class="label aim-label" id="goal-h" data-reveal="both">[ 03 · What we want to accomplish ]</p>
      <div class="aim">
        <div class="aim__text">
        <p class="statement" data-reveal="both" data-split>A business’s digital presence should reflect the quality of the business itself.</p>
        <p class="body-l measure gap-copy" data-reveal="both">Businesses put real time and effort into their spaces, products, services, customer experience and reputation. When someone discovers that business online, the digital experience should show the same level of care. <strong>Solace exists to help close that gap.</strong></p>
        </div>
        <figure class="graph" data-reveal="both">
          <ul class="graph__key" aria-hidden="true">
            <li><i class="k k--biz"></i>The business</li>
            <li><i class="k k--web"></i>Its digital presence</li>
          </ul>
          <svg viewBox="0 0 720 360" role="img" aria-labelledby="graph-t">
            <title id="graph-t">Illustration: over time, the quality of the business and the quality of its digital presence rise together.</title>
            <g class="axes">
              <line x1="56" y1="20" x2="56" y2="330" />
              <line x1="56" y1="330" x2="700" y2="330" />
              <path d="M50 30 L56 20 L62 30" />
              <path d="M690 324 L700 330 L690 336" />
            </g>
            <text class="ax" x="70" y="28">QUALITY</text>
            <text class="ax" x="690" y="352" text-anchor="end">TIME</text>
            <g class="links">
              <line x1="228.9" y1="247.8" x2="235.5" y2="274.9" style="--o:0" />
              <line x1="385.5" y1="177.2" x2="392.7" y2="206.7" style="--o:1" />
              <line x1="535.3" y1="108.9" x2="539.3" y2="141" style="--o:2" />
            </g>
            <path class="line line--biz" pathLength="1" d="M56 292 C240 276 400 150 648 66" />
            <path class="line line--web" pathLength="1" d="M56 318 C250 302 410 180 648 100" />
            <path class="head head--biz" d="M-14 -7 L0 0 L-14 7" transform="translate(648 66) rotate(-18.7)" />
            <path class="head head--web" d="M-14 -7 L0 0 L-14 7" transform="translate(648 100) rotate(-18.6)" />
            <g class="dots">
              <circle class="dot--biz" cx="228.9" cy="247.8" r="4.5" style="--o:0" /><circle class="dot--web" cx="235.5" cy="274.9" r="4.5" style="--o:0" />
              <circle class="dot--biz" cx="385.5" cy="177.2" r="4.5" style="--o:1" /><circle class="dot--web" cx="392.7" cy="206.7" r="4.5" style="--o:1" />
              <circle class="dot--biz" cx="535.3" cy="108.9" r="4.5" style="--o:2" /><circle class="dot--web" cx="539.3" cy="141" r="4.5" style="--o:2" />
            </g>
            <text class="lbl" x="640" y="46" text-anchor="end">The business</text>
            <text class="lbl lbl--2" x="562" y="150">Its digital presence</text>
          </svg>
          <figcaption class="label">As the business grows, its digital presence should rise with it.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Great design and reasonable cost -->
  <section class="pad section" aria-labelledby="cost-h">
    <div class="inner sec sec--a">
      <div class="sec__side"><p class="label" id="cost-h" data-reveal="both">[ 04 · Design and cost ]</p></div>
      <div class="sec__head">
        <p class="statement" data-reveal="both" data-split>You shouldn’t have to choose between great design <span class="fade">and reasonable cost.</span></p>
      </div>
      <div class="sec__body">
        <p class="body-l measure cost-copy" data-reveal="both">We deliver high-quality work more efficiently by using modern technology and keeping a lean process. It isn’t about being cheaper. It’s about removing what doesn’t add value.</p>
        <ol class="approach">
          {approach.map((a, i) => (
            <li class="tile-in" data-reveal="both" style={`--d:${i * 90}ms`}><span class="no">0{i + 1}</span>{a}</li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <Beliefs items={beliefs} />

  <!-- Close -->
  <section class="pad section close" aria-label="Work with us">
    <div class="inner">
      <p class="statement" data-reveal="both" data-split>Solace builds digital experiences that feel modern, intentional and distinctive, <span class="fade">worthy of the businesses behind them.</span></p>
      <div class="actions" data-reveal="both" style="--d:120ms">
        <a class="btn btn--solid" href="/contact/">Start a project <span aria-hidden="true">↗</span></a>
        <a class="btn btn--ghost" href="/work/">See the work</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .head { padding-top: 72px; padding-bottom: 64px; }
  .head .statement { margin-top: 14px; max-width: 980px; }
  .intro { margin-top: 22px; color: #3C4547; }
  :global(.studio-media) { height: clamp(320px, 42vw, 640px); }

  .body-l { color: #3C4547; }
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; margin-top: 40px; }

  /* Sections 01 and 04 */
  .sec { display: grid; column-gap: 64px; }
  .sec .statement { max-width: 1100px; }
  .sec__body { margin-top: 40px; }
  .sec .cost-copy { margin-top: 0; }
  /* 04 — label on top, everything uses the full width */
  .sec--a { grid-template-areas: "side" "head" "body"; }
  .sec--a .sec__side { margin-bottom: 28px; }
  /* 01 — label on top; heading on the left half, supporting text on the right */
  .sec--c { grid-template-columns: 1fr 1fr; grid-template-areas: "side side" "head body"; align-items: start; }
  .sec--c .sec__side { margin-bottom: 28px; }
  .sec--c .sec__body { margin-top: 0; padding-top: 10px; }
  .sec--c .cols { grid-template-columns: 1fr; gap: 20px; }
  .sec__side { grid-area: side; } .sec__head { grid-area: head; } .sec__body { grid-area: body; }

  /* 02 — dark band with the motto lighting up word by word as it scrolls through */
  .dark { background: var(--ink); color: var(--white); }
  .dark .label { color: var(--gray); }
  .dark .body-l { color: rgba(255,255,255,.78); }
  .motto { font-size: clamp(36px, 5.4vw, 84px); line-height: 1.04; letter-spacing: -.03em; font-weight: 500; margin: 28px 0 44px; max-width: 15ch; }
  :global(.js) .motto .w { color: rgba(255,255,255,.26); transition: color 300ms var(--ease); }
  :global(.js) .motto .w.is-lit { color: var(--white); }
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 56px; }
  .side { border-top: 1px solid rgba(255,255,255,.14); }
  .bar { display: block; background: var(--white); color: var(--ink); font-size: 13px; font-weight: 500; padding: 10px 12px; letter-spacing: .03em; }
  .bar--light { background: var(--sky); }
  .no { font-family: var(--mono); font-size: 11px; color: var(--slate); margin-right: 6px; }
  .side p { font-size: 16px; line-height: 1.55; color: rgba(255,255,255,.78); margin-top: 14px; max-width: 40ch; }
  .goal { font-size: clamp(20px, 1.8vw, 26px); line-height: 1.3; letter-spacing: -.01em; font-weight: 500; margin-top: 64px; max-width: 30ch; }
  .goal .fade { color: var(--sky); }

  /* 03 — the business and its digital presence rising together */
  .gap-copy { margin-top: 28px; }
  .gap-copy strong { font-weight: 500; color: var(--ink); }
  .aim-label { margin-bottom: 28px; }
  /* Desktop: text on the left, graph on the right */
  .aim { display: grid; grid-template-columns: 5fr 7fr; gap: 64px; align-items: center; }
  .graph { max-width: 760px; }
  @media (max-width: 1023px) {
    .aim { grid-template-columns: 1fr; gap: 44px; }
  }
  .graph__key { display: flex; gap: 22px; flex-wrap: wrap; list-style: none; font-size: 13px; color: #3C4547; margin-bottom: 14px; }
  .graph__key li { display: flex; align-items: center; gap: 8px; }
  .k { display: block; width: 18px; height: 2px; border-radius: 2px; }
  .k--biz { background: var(--ink); }
  .k--web { background: var(--blue); }
  .graph svg { width: 100%; height: auto; overflow: visible; }
  .axes line, .axes path { stroke: #C9CCC8; stroke-width: 1; fill: none; }
  .ax { font-family: var(--mono); font-size: 11px; letter-spacing: .04em; fill: var(--slate); }
  .lbl { font-size: 14px; font-weight: 500; fill: var(--ink); }
  .lbl--2 { fill: var(--slate); }
  .line, .head { fill: none; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  .line--biz, .head--biz { stroke: var(--ink); }
  .line--web, .head--web { stroke: var(--blue); }
  .links line { stroke: var(--gray); stroke-width: 1; stroke-dasharray: 2 4; }
  .dots circle { stroke: var(--paper); stroke-width: 2; }
  .dot--biz { fill: var(--ink); }
  .dot--web { fill: var(--blue); }
  .graph figcaption { margin-top: 14px; }
  @media (max-width: 639px) {
    .graph .lbl { display: none; } /* the key above names both lines */
    .graph .ax { font-size: 20px; }
  }
  /* Lines draw in together, then the arrowheads, links and labels arrive; it plays back out on the way out */
  :global(.js) .graph .line { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1500ms var(--ease); }
  :global(.js) .graph .line--web { transition-delay: 150ms; }
  :global(.js) .graph.is-in .line { stroke-dashoffset: 0; }
  :global(.js) .graph .head, :global(.js) .graph .lbl { opacity: 0; transition: opacity 400ms var(--ease); }
  :global(.js) .graph.is-in .head, :global(.js) .graph.is-in .lbl { opacity: 1; transition-delay: 1300ms; }
  :global(.js) .graph .links line, :global(.js) .graph .dots circle { opacity: 0; transition: opacity 350ms var(--ease); }
  :global(.js) .graph.is-in .links line, :global(.js) .graph.is-in .dots circle { opacity: 1; transition-delay: calc(500ms + var(--o) * 280ms); }

  /* 04 — approach, in the black-bar style of the Process section */
  .cost-copy { margin-top: 28px; }
  .approach { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-top: 44px; }
  .approach li { background: var(--ink); color: var(--white); font-size: 14px; font-weight: 500; padding: 12px; min-height: 92px; display: flex; flex-direction: column; justify-content: space-between; gap: 18px; }
  .approach .no { color: var(--gray); }

  /* Extra motion on this page */
  /* Bracket labels wipe in from the left */
  :global(.js) .label[data-reveal] { clip-path: inset(0 100% 0 0); transition: opacity var(--t-reveal) var(--ease), transform var(--t-reveal) var(--ease), clip-path 800ms var(--ease); }
  :global(.js) .label[data-reveal].is-in { clip-path: inset(0 0 0 0); }
  /* Studio image settles from a slight zoom while it unmasks */
  .media-wrap { overflow: hidden; }
  :global(.js) .media-wrap :global(.studio-media) { transform: scale(1.08); transition: clip-path 900ms var(--ease), transform 1600ms var(--ease); }
  :global(.js) .media-wrap :global(.studio-media.is-in) { transform: none; }
  /* Technology / human eye bars draw across */
  :global(.js) .side .bar { clip-path: inset(0 100% 0 0); transition: clip-path 900ms var(--ease) 150ms; }
  :global(.js) .side.is-in .bar { clip-path: inset(0 0 0 0); }
  /* Approach tiles rise from the bottom edge */
  :global(.js) .tile-in { clip-path: inset(100% 0 0 0); transition: opacity var(--t-reveal) var(--ease), transform var(--t-reveal) var(--ease), clip-path 800ms var(--ease), background var(--t-fast) var(--ease); transition-delay: var(--d, 0ms); }
  :global(.js) .tile-in.is-in { clip-path: inset(0 0 0 0); }
  .approach li:hover { background: var(--navy); }
  .actions .btn span { display: inline-block; transition: transform var(--t-fast) var(--ease); }
  .actions .btn:hover span { transform: translate(2px, -2px); }

  .close { padding-top: 0; }
  .close .statement { max-width: 980px; }
  .actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 32px; }

  @media (max-width: 1023px) {
    .approach { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 767px) {
    .sec { grid-template-columns: 1fr; grid-template-areas: "side" "head" "body"; }
    .sec__side { margin-bottom: 16px; }
    .sec--c .sec__body { padding-top: 0; margin-top: 28px; }
    .cols, .split { grid-template-columns: 1fr; gap: 24px; }
    .cols { margin-top: 28px; }
    .split { margin-top: 40px; }
    .goal { margin-top: 44px; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .motto .w { color: var(--white); }
    :global(.js) .graph .line { stroke-dashoffset: 0; }
    :global(.js) .graph .head, :global(.js) .graph .lbl, :global(.js) .graph .links line, :global(.js) .graph .dots circle { opacity: 1; }
    :global(.js) .label[data-reveal], :global(.js) .side .bar, :global(.js) .tile-in { clip-path: none; }
    :global(.js) .media-wrap :global(.studio-media) { transform: none; }
  }
</style>
