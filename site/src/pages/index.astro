---
import Base from '../layouts/Base.astro';
import HeroSingle from '../components/HeroSingle.astro';
import ProjectFeature from '../components/ProjectFeature.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import { projects } from '../data/projects';
import { filters, serviceGroups } from '../data/site';


import revealDay from '../assets/hero/reveal-day.jpg';
import revealNight from '../assets/hero/reveal-night.jpg';

// Words in the studio's rotating cloud: the three service groups and everything listed under them
const cloudWords = serviceGroups.flatMap((g) => [g.name, ...g.items]);
---
<Base overHero>
  <HeroSingle
    reveal={{
      day: revealDay,
      night: revealNight,
      dayAlt: 'A wildflower meadow, lake and snow-capped mountains in soft morning light.',
      nightAlt: '',
    }}
    words={['Design', 'Technology', 'Creative', 'Growth']}
    cta={{ label: 'View work', href: '/work/' }}
  />

  <section class="statement-row pad section" aria-labelledby="about-h">
    <div class="inner about">
      <div class="about__text">
        <p class="label" id="about-h" data-reveal>[ About the studio ]</p>
        <p class="statement" data-reveal>
          A website is where the relationship starts, not where it ends.{' '}
          <span class="fade">So we stay — designing, shooting, building and improving as your business grows.</span>
        </p>
      </div>
      <div class="cloud" data-cloud data-words={JSON.stringify(cloudWords)} role="group" aria-label="What we do: drag to turn the cloud" data-reveal style="--d:120ms"></div>
    </div>
  </section>

  <section class="band pad section work" aria-labelledby="work-h">
    <div class="inner">
      <div class="work-top">
        <div>
          <h2 class="section-caps" id="work-h">Latest: Selected work</h2>
          <a class="more link-u" href="/work/">MORE</a>
        </div>
        <nav class="chips" aria-label="Browse work by service">
          <a class="chip is-on" href="/work/">All</a>
          {filters.map((f) => <a class="chip" href={`/work/?filter=${encodeURIComponent(f)}`}>{f}</a>)}
        </nav>
      </div>
      <div class="projects">
        {projects.slice(0, 2).map((p) => <ProjectFeature project={p} />)}
      </div>
    </div>
  </section>

  <section class="pad section" aria-label="Services">
    <div class="inner"><Services /></div>
  </section>

  <section class="pad process-wrap" aria-label="Process">
    <div class="inner"><Process /></div>
  </section>
</Base>

<style>
  .statement-row { overflow-x: clip; padding-top: 64px; padding-bottom: 64px; }
  .about { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
  .about__text .statement { margin-top: 18px; }
  /* Bigger sphere that still takes up only 300px of height: the extra size hangs over the section's padding */
  .cloud { position: relative; width: 100%; aspect-ratio: 1; max-width: 460px; justify-self: center; margin-block: calc((300px - min(100%, 460px)) / 2); }
  .work-top { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; }
  .more { display: inline-block; margin-top: 8px; font-size: 13px; }
  .chips { display: flex; gap: 6px; flex-wrap: wrap; }
  .projects { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px; margin-top: 40px; }
  .process-wrap { padding-bottom: var(--section); }
  @media (max-width: 767px) {
    .about { grid-template-columns: 1fr; gap: 12px; text-align: center; }
    .statement-row { padding-top: 48px; padding-bottom: 48px; }
    /* full phone width: break out of the side padding */
    .cloud { max-width: none; width: 100vw; justify-self: center; margin-block: 0; margin-inline: calc(50% - 50vw); }
    .projects { grid-template-columns: 1fr; gap: 32px; }
  }
</style>
