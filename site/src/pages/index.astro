---
import Base from '../layouts/Base.astro';
import HeroSingle from '../components/HeroSingle.astro';
import ProjectFeature from '../components/ProjectFeature.astro';
import HomeServices from '../components/HomeServices.astro';
import Process from '../components/Process.astro';
import Mascot from '../components/Mascot.astro';
import { projects } from '../data/projects';
import { filters } from '../data/site';
---
<Base overHero lightHero>
  <HeroSingle
    flow
    words={['Design', 'Technology', 'Creative', 'Growth']}
    cta={{ label: 'View work', href: '/work/' }}
    cta2={{ label: 'Request a quote', href: '/contact/' }}
  />

  <section class="statement-row pad" id="about" aria-labelledby="about-h">
    <div class="inner about">
      <p class="label" id="about-h" data-reveal>[ About the studio ]</p>
      <p class="statement" data-reveal>
        A website is where the relationship starts, not where it ends.{' '}
        <span class="fade">So we stay — designing, shooting, building and improving as your business grows.</span>
      </p>
    </div>
  </section>

  <section class="band pad section work" id="work" aria-labelledby="work-h">
    <div class="inner">
      <div class="work-top">
        <div>
          <h2 class="section-caps" id="work-h">Latest: Selected work</h2>
          <a class="more link-u" href="/work/">MORE</a>
        </div>
        <nav class="chips" aria-label="Browse work by service">
          <a class="chip is-on" href="/work/">All</a>
          {filters.map((f) => <a class="chip" href={`/work/?filter=${encodeURIComponent(f)}`}>{f}</a>)}
        </nav>
      </div>
      <div class="projects">
        {projects.slice(0, 2).map((p) => <ProjectFeature project={p} />)}
      </div>
    </div>
  </section>

  <HomeServices />

  <section class="pad process-wrap" aria-label="Process">
    <div class="inner"><Process /></div>
  </section>

  <section class="cta-wrap pad" id="start" aria-labelledby="cta-h">
    <div class="inner">
      <div class="cta" data-reveal>
        <div class="cta__text">
          <h2 id="cta-h">Let’s build your <span class="fade">digital presence.</span></h2>
          <p>Tell us about your business. We read every message ourselves and reply personally.</p>
          <div class="cta__btns">
            <a class="btn btn--solid" href="/contact/">Request a quote <span aria-hidden="true">↗</span></a>
            <a class="btn-glass" href="/contact/">Start a project</a>
          </div>
        </div>
        <Mascot name="hello" width={150} class="cta__bot" />
      </div>
    </div>
  </section>
</Base>

<style>
  .statement-row { overflow-x: clip; padding-top: clamp(64px, 9vw, 130px); padding-bottom: clamp(72px, 10vw, 150px); background: radial-gradient(900px 520px at 90% 40%, rgba(165,201,225,.30), transparent 65%), var(--paper); }
  .about { max-width: 1100px; margin: 0 auto 0 0; }
  .about .statement { margin-top: 22px; font-size: clamp(30px, 3.4vw, 50px); line-height: 1.1; }
  .work { background: linear-gradient(180deg, var(--paper) 0%, #E8EDF0 100%); }
  .work-top { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; }
  .more { display: inline-block; margin-top: 8px; font-size: 13px; }
  .chips { display: flex; gap: 6px; flex-wrap: wrap; }
  .projects { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px; margin-top: 40px; }
  .process-wrap { padding-top: var(--section); padding-bottom: var(--section); background: radial-gradient(800px 420px at 15% 0%, rgba(165,201,225,.26), transparent 62%), var(--paper); }
  .cta-wrap { background: var(--paper); padding-bottom: var(--section); }
  .cta { position: relative; overflow: hidden; padding: clamp(36px, 5vw, 72px) clamp(24px, 4.5vw, 64px); border-radius: 34px; border: 1px solid transparent;
    background: linear-gradient(135deg, rgba(255,255,255,.92), rgba(236,241,244,.85)) padding-box,
      linear-gradient(120deg, rgba(165,201,225,.95), rgba(255,255,255,.95), rgba(206,190,236,.75), rgba(255,214,190,.75), rgba(165,201,225,.95)) border-box;
    box-shadow: 0 40px 90px rgba(35,48,54,.14); }
  .cta__text { position: relative; z-index: 1; max-width: 820px; }
  .cta h2 { font-size: clamp(34px, 4.6vw, 58px); line-height: 1.05; letter-spacing: -.03em; font-weight: 500; }
  .cta h2 .fade { color: var(--blue); }
  .cta p { margin: 22px 0 34px; font-size: 17px; line-height: 1.5; color: #3C4547; max-width: 52ch; }
  .cta__btns { display: flex; flex-wrap: wrap; gap: 12px; }
  .cta__btns .btn { min-height: 54px; padding-inline: 32px; font-size: 15px; }
  .cta__btns .btn-glass { min-height: 54px; padding-inline: 32px; font-size: 15px; }
  .cta :global(.cta__bot) { position: absolute; right: 56px; bottom: 40px; }
  @media (max-width: 1023px) { .cta :global(.cta__bot) { display: none; } }
  @media (max-width: 767px) {
    .statement-row { text-align: center; }
    .about { margin-inline: auto; }
    .projects { grid-template-columns: 1fr; gap: 32px; }
  }
</style>
